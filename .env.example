# ==============================================================================
# Craft Keeper - Environment Configuration
# ==============================================================================

# Active backend selection.
# Options:
#   - mock: 100% offline verified sample data (default, zero setup needed)
#   - gemma_local: local faster-whisper + local Gemma (Ollama/GGUF)
#   - gemma_hosted: hosted Gemma 4 (gemma-4-31b-it) via Google AI Studio API
#   - gemini_fallback: hosted Gemini direct raw audio multimodal fallback
CRAFT_BACKEND=mock

# ------------------------------------------------------------------------------
# Hosted Backend Configuration (Required only when CRAFT_BACKEND=gemma_hosted)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Hosted model identifier (Default: gemma-4-31b-it for honest Gemma usage)
HOSTED_MODEL=gemma-4-31b-it

# Set to 'true' only if passing raw audio directly to Gemini without Whisper
USE_DIRECT_AUDIO_GEMINI=false

# ------------------------------------------------------------------------------
# Local Backend Configuration (Required only when CRAFT_BACKEND=gemma_local)
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
